# =================================================================
# Pathfinder Server - Environment Configuration (.env.example)
# =================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Fill in your own credentials below.
# =================================================================

# -----------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------
FLASK_ENV=development
PORT=5002

# -----------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# -----------------------------------------------------------------
# Local MongoDB instance or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/pathfinder_db
DB_NAME=pathfinder_db

# -----------------------------------------------------------------
# 3. Security & Authentication (JWT)
# -----------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens
# Generate a strong key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=pathfinder_super_secret_jwt_key_2026_change_me_in_prod

# -----------------------------------------------------------------
# 4. Google Gemini API (LLM & Conversational Mentor)
# -----------------------------------------------------------------
# Get your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 5. YouTube Data API v3 (Automated Playlist Discovery)
# -----------------------------------------------------------------
# Get your API key from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# (Enable "YouTube Data API v3" for your project)
YOUTUBE_API_KEY=your_youtube_api_key_here
